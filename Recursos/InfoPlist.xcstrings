          "stringUnit" : {
            "state" : "translated",
            "value" : "Iconos pone el icono que elegiste dentro de la app (archivo Icon) y lo cambia con el modo claro u oscuro."
          }
        }
      }
    }
  },
  "version" : "1.0"
}

{
  "sourceLanguage" : "es",
  "strings" : {
    "NSAppBundlesUsageDescription" : {
      "comment" : "Info.plist: por que la app pide Gestion de apps",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iconos Agente switches the icon of the apps you chose in Iconos with Light or Dark mode and sets it again when they update."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iconos Agente cambia el icono de las apps que elegiste en Iconos con el modo claro u oscuro y lo vuelve a poner cuando se actualizan."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
